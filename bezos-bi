<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BEZOS AI - Ask Anything ❤️</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif}
:root{--bg:#0b0714;--card:#17102a;--card2:#1f1738;--border:#2e2450;--text:#fff;--muted:#a99fc9;--accent:#a855f7;--accent2:#ec4899;--green:#22c55e}
body.light{--bg:#f6f3ff;--card:#ffffff;--card2:#f0ebff;--border:#e2d9ff;--text:#1a1033;--muted:#6b5f9e}
body{background:var(--bg);color:var(--text);height:100vh;height:100dvh;display:flex;overflow:hidden;transition:.3s}
button{cursor:pointer;border:none;font-family:inherit}
::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-thumb{background:#3b2d6a;border-radius:10px}
/* SIDEBAR */
.sidebar{width:280px;background:var(--card);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:16px;flex-shrink:0;transition:.3s}
.logo{display:flex;align-items:center;gap:10px;padding:6px 6px 16px}
.logo-icon{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#a855f7,#ec4899);display:grid;place-items:center;font-size:22px;box-shadow:0 8px 20px rgba(168,85,247,.4)}
.logo h2{font-size:20px;font-weight:900;letter-spacing:-.5px}.logo p{font-size:11px;color:var(--muted);font-weight:600}
.new-btn{background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;padding:13px;border-radius:12px;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 20px rgba(168,85,247,.3)}
.new-btn:active{transform:scale(.98)}
.search-box{margin:14px 0 10px;background:var(--card2);border:1px solid var(--border);border-radius:12px;padding:11px 12px;display:flex;gap:8px;align-items:center}
.search-box input{background:transparent;border:none;outline:none;color:var(--text);width:100%;font-size:13px}
.search-box input::placeholder{color:var(--muted)}
.hist-label{font-size:11px;letter-spacing:1.5px;color:var(--muted);font-weight:700;margin:10px 6px 8px}
.history{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px}
.hist-item{background:transparent;color:var(--text);text-align:left;padding:11px 12px;border-radius:10px;font-size:13px;display:flex;gap:8px;align-items:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;border:1px solid transparent}
.hist-item:hover,.hist-item.active{background:var(--card2);border-color:var(--border)}
.hist-item span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.side-foot{border-top:1px solid var(--border);padding-top:12px;display:flex;flex-direction:column;gap:6px}
.side-foot button{background:transparent;color:var(--text);padding:10px 12px;border-radius:10px;text-align:left;font-size:13px;display:flex;gap:9px;align-items:center}
.side-foot button:hover{background:var(--card2)}
.user-row{display:flex;align-items:center;gap:10px;background:var(--card2);padding:10px;border-radius:12px;margin-top:8px;border:1px solid var(--border)}
.avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#ec4899);display:grid;place-items:center;font-weight:900;font-size:14px;color:#fff;flex-shrink:0}
/* MAIN */
.main{flex:1;display:flex;flex-direction:column;min-width:0}
.topbar{height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid var(--border);background:var(--bg)}
.topbar-left{display:flex;gap:10px;align-items:center}
.menu-btn{display:none;background:var(--card);color:var(--text);width:38px;height:38px;border-radius:10px;border:1px solid var(--border);font-size:18px}
.model-pill{background:var(--card);border:1px solid var(--border);padding:8px 12px;border-radius:20px;font-size:13px;font-weight:600;display:flex;gap:6px;align-items:center}
.dot{width:8px;height:8px;background:var(--green);border-radius:50%;box-shadow:0 0 0 3px rgba(34,197,94,.2)}
.top-actions{display:flex;gap:8px}
.icon-btn{background:var(--card);border:1px solid var(--border);color:var(--text);width:38px;height:38px;border-radius:10px;font-size:16px}
.icon-btn:hover{background:var(--card2)}
/* CHAT */
.chat{flex:1;overflow-y:auto;padding:22px 18px 10px;scroll-behavior:smooth}
.center{max-width:760px;margin:0 auto}
.welcome{text-align:center;padding:28px 10px 18px;animation:fadeUp .5s both}
.welcome-icon{font-size:56px;margin-bottom:10px;filter:drop-shadow(0 10px 20px rgba(168,85,247,.4))}
.welcome h1{font-size:34px;font-weight:900;letter-spacing:-1px;line-height:1.1}
.welcome h1 span{background:linear-gradient(135deg,#a855f7,#ec4899,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.welcome p{color:var(--muted);margin-top:10px;line-height:1.6;font-size:15px}
.chips{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:18px 0}
.chip{background:var(--card);border:1px solid var(--border);padding:9px 13px;border-radius:20px;font-size:13px;color:var(--text);font-weight:500}
.chip:hover{border-color:#a855f7;transform:translateY(-1px)}
.cards{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;margin-top:6px}
.mini-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:14px;text-align:left;transition:.2s}
.mini-card:hover{transform:translateY(-2px);border-color:#a855f7}
.mini-card b{font-size:13px;display:block;margin-bottom:4px}.mini-card p{font-size:12px;color:var(--muted);line-height:1.5}
.msg{max-width:760px;margin:0 auto 16px;display:flex;gap:12px;animation:fadeUp .35s both}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.msg-avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;font-size:16px}
.msg.user .msg-avatar{background:linear-gradient(135deg,#6366f1,#a855f7);color:#fff}
.msg.ai .msg-avatar{background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff}
.msg-body{flex:1;min-width:0;padding-top:4px}
.msg-name{font-size:12px;font-weight:700;color:var(--muted);margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px}
.msg-text{font-size:15px;line-height:1.7;white-space:pre-wrap;word-break:break-word}
.msg-text b{font-weight:700}.msg-text code{font-family:'JetBrains Mono',monospace;background:var(--card2);border:1px solid var(--border);padding:2px 6px;border-radius:6px;font-size:13px}
.msg-text pre{background:#0f0a1e;color:#e9d5ff;padding:14px;border-radius:12px;overflow-x:auto;margin:10px 0;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.6;border:1px solid #2e2450}
.msg-text pre code{background:transparent;border:none;padding:0}
.msg-actions{display:flex;gap:6px;margin-top:8px}
.small-btn{background:var(--card);border:1px solid var(--border);color:var(--muted);padding:6px 10px;border-radius:20px;font-size:12px}
.typing{display:flex;gap:5px;padding:10px 0}
.typing i{width:8px;height:8px;background:var(--muted);border-radius:50%;animation:blink 1s infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes blink{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:1;transform:translateY(-4px)}}
/* INPUT */
.input-area{padding:12px 16px 14px;border-top:1px solid var(--border);background:var(--bg)}
.input-wrap{max-width:760px;margin:0 auto}
.input-box{background:var(--card);border:1.5px solid var(--border);border-radius:20px;padding:10px 10px 10px 16px;display:flex;align-items:flex-end;gap:8px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
.input-box:focus-within{border-color:#a855f7;box-shadow:0 0 0 3px rgba(168,85,247,.15)}
.input-box textarea{flex:1;background:transparent;border:none;outline:none;color:var(--text);resize:none;max-height:120px;font-size:15px;line-height:1.5;padding:8px 0;font-family:inherit}
.input-box textarea::placeholder{color:var(--muted)}
.send-btn{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;font-size:18px;flex-shrink:0;box-shadow:0 6px 16px rgba(168,85,247,.35)}
.send-btn:disabled{opacity:.4}
.attach-btn{background:transparent;color:var(--muted);width:38px;height:38px;border-radius:10px;font-size:18px;flex-shrink:0}
.input-hint{text-align:center;font-size:11px;color:var(--muted);margin-top:8px}
.quick{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-bottom:10px}
.quick button{background:var(--card);border:1px solid var(--border);color:var(--text);padding:7px 11px;border-radius:20px;font-size:12px}
.toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:#111;color:#fff;padding:11px 16px;border-radius:20px;font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:.3s;z-index:99;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
@media(max-width:900px){.sidebar{position:fixed;left:-300px;top:0;bottom:0;z-index:50;box-shadow:20px 0 40px rgba(0,0,0,.4)}.sidebar.open{left:0}.menu-btn{display:grid;place-items:center}.cards{grid-template-columns:1fr 1fr}.welcome h1{font-size:28px}}
@media(max-width:520px){.cards{grid-template-columns:1fr}.chat{padding:14px 12px}.welcome{padding:16px 4px}.topbar{padding:0 12px}}
</style>
</head>
<body>
<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="logo"><div class="logo-icon">🤖</div><div><h2>BEZOS AI</h2><p>Ask Anything • 2026</p></div></div>
  <button class="new-btn" onclick="newChat()">＋ New Chat</button>
  <div class="search-box">🔍 <input id="searchHist" placeholder="Search chats..." oninput="filterHist()"></div>
  <div class="hist-label">TODAY • HISTORY</div>
  <div class="history" id="history"></div>
  <div class="side-foot">
    <button onclick="toggleTheme()">🌙 / ☀️ Toggle Theme</button>
    <button onclick="clearAll()">🗑️ Clear All Chats</button>
    <button onclick="showHelp()">❓ How To Use</button>
    <div class="user-row"><div class="avatar">BE</div><div style="flex:1;min-width:0"><div style="font-weight:700;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">BEZOS User</div><div style="font-size:11px;color:var(--muted)">Free Plan • Unlimited</div></div><span style="color:#22c55e;font-size:11px;font-weight:700">● ONLINE</span></div>
  </div>
</aside>
<!-- MAIN -->
<main class="main">
  <div class="topbar">
    <div class="topbar-left"><button class="menu-btn" onclick="toggleSide()">☰</button><div class="model-pill"><span class="dot"></span> BEZOS AI • GPT-4 Level <span style="color:#a855f7">▼</span></div></div>
    <div class="top-actions"><button class="icon-btn" onclick="toggleTheme()" title="Theme">🌙</button><button class="icon-btn" onclick="newChat()" title="New">＋</button><button class="icon-btn" onclick="shareChat()" title="Share">↗️</button></div>
  </div>
  <div class="chat" id="chat"><div class="center" id="centerBox">
    <div class="welcome" id="welcome">
      <div class="welcome-icon">✨🤖✨</div>
      <h1>Hello, I'm <span>BEZOS AI</span><br>Ask Me Anything</h1>
      <p>I can answer <b>all questions in this world</b> — Maths, Science, English, Twi, Code, BECE, WASSCE, Business, Love, Health, History, Bible, Football, Anything!</p>
      <div class="chips"><button class="chip" onclick="askQuick('Explain Set Theory for BECE')">📐 Set Theory</button><button class="chip" onclick="askQuick('Give me 10 WASSCE questions')">📚 WASSCE</button><button class="chip" onclick="askQuick('Write HTML for a love website')">💻 Code</button><button class="chip" onclick="askQuick('How to make money in Ghana?')">💰 Money</button><button class="chip" onclick="askQuick('Translate I love you to Twi')">🇬🇭 Twi</button></div>
      <div class="cards">
        <button class="mini-card" onclick="askQuick('Solve: 2x + 5 = 17, find x')"><b>🧮 Maths Solver</b><p>Solve any maths step-by-step</p></button>
        <button class="mini-card" onclick="askQuick('Write a story about a boy in Kumasi who becomes rich')"><b>📖 Story Writer</b><p>Stories, essays, letters</p></button>
        <button class="mini-card" onclick="askQuick('Make a timetable for BECE student')"><b>📅 Study Plan</b><p>BECE, WASSCE timetable</p></button>
        <button class="mini-card" onclick="askQuick('Give me a business idea with 500 cedis in Ghana')"><b>💡 Business Ideas</b><p>Ideas for Ghana & Africa</p></button>
      </div>
    </div>
    <div id="messages"></div>
  </div></div>
  <div class="input-area"><div class="input-wrap">
    <div class="quick"><button onclick="askQuick('What is photosynthesis?')">Photosynthesis</button><button onclick="askQuick('Who is the richest man in the world?')">Richest Man</button><button onclick="askQuick('How to learn coding fast?')">Learn Coding</button><button onclick="askQuick('Write a birthday message for Erica')">For Erica ❤️</button></div>
    <div class="input-box"><button class="attach-btn" onclick="showToast('Voice coming soon! Type for now 🎤')">🎤</button><textarea id="input" rows="1" placeholder="Ask BEZOS AI anything... e.g. Solve 2x+5=17" onkeydown="handleKey(event)" oninput="autoGrow(this)"></textarea><button class="attach-btn" onclick="showToast('Attach coming soon!')">📎</button><button class="send-btn" id="sendBtn" onclick="sendMsg()">↑</button></div>
    <div class="input-hint">BEZOS AI can make mistakes. Check important info. • Free • No Login Needed • Made in Ghana 🇬🇭</div>
  </div></div>
</main>
<div class="toast" id="toast">Copied!</div>
<script>
// ============ BEZOS AI ENGINE - ANSWERS ALL QUESTIONS ============
let chats = JSON.parse(localStorage.getItem('bezos_chats')||'[]');
let currentId = null;
let isTyping = false;

function saveChats(){ localStorage.setItem('bezos_chats', JSON.stringify(chats)); renderHist(); }
function newChat(){
  currentId = Date.now().toString();
  chats.unshift({id:currentId, title:'New Chat', msgs:[], time:new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})});
  saveChats(); document.getElementById('messages').innerHTML=''; document.getElementById('welcome').style.display='block';
  document.getElementById('input').focus(); closeSide(); showToast('New chat started ✨');
}
function renderHist(){
  const box=document.getElementById('history'); box.innerHTML='';
  if(chats.length===0){ box.innerHTML='<div style="padding:12px;color:var(--muted);font-size:13px;text-align:center">No chats yet.<br>Start asking!</div>'; return; }
  chats.forEach(c=>{
    const b=document.createElement('button'); b.className='hist-item'+(c.id===currentId?' active':'');
    b.innerHTML=`💬 <span>${escapeHtml(c.title)}</span>`;
    b.onclick=()=>loadChat(c.id); box.appendChild(b);
  });
}
function loadChat(id){
  currentId=id; const c=chats.find(x=>x.id===id); if(!c) return;
  document.getElementById('welcome').style.display='none';
  const m=document.getElementById('messages'); m.innerHTML='';
  c.msgs.forEach(msg=>addMsgToUI(msg.role, msg.text, false));
  renderHist(); closeSide(); scrollBottom();
}
function filterHist(){
  const q=document.getElementById('searchHist').value.toLowerCase();
  document.querySelectorAll('.hist-item').forEach(el=>{
    el.style.display = el.textContent.toLowerCase().includes(q) ? 'flex':'none';
  });
}
function clearAll(){ if(confirm('Clear all chats?')){ chats=[]; currentId=null; saveChats(); document.getElementById('messages').innerHTML=''; document.getElementById('welcome').style.display='block'; } }
function toggleTheme(){ document.body.classList.toggle('light'); showToast(document.body.classList.contains('light')?'Light mode ☀️':'Dark mode 🌙'); }
function toggleSide(){ document.getElementById('sidebar').classList.toggle('open'); }
function closeSide(){ if(window.innerWidth<900) document.getElementById('sidebar').classList.remove('open'); }
function showHelp(){ alert('BEZOS AI HELP:\n\n1. Type any question below\n2. Press Enter or Send ↑\n3. I go answer you - Maths, Science, Code, Twi, Anything!\n\nTry: "Solve 2x+5=17"\nTry: "Write a story"\nTry: "Translate to Twi"\n\nMade for BEZOS 2026 👑'); }
function shareChat(){ navigator.clipboard.writeText(location.href); showToast('Link copied! Share BEZOS AI 🔗'); }
function showToast(t){ const el=document.getElementById('toast'); el.textContent=t; el.classList.add('show'); setTimeout(()=>el.classList.remove('show'),2200); }
function escapeHtml(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function formatText(t){
  let h=escapeHtml(t);
  h=h.replace(/```([\s\S]*?)```/g,'<pre><code>$1</code></pre>');
  h=h.replace(/\*\*(.*?)\*\*/g,'<b>$1</b>');
  h=h.replace(/`([^`]+)`/g,'<code>$1</code>');
  h=h.replace(/^### (.*)$/gm,'<b>$1</b>');
  h=h.replace(/^## (.*)$/gm,'<b>$1</b>');
  return h;
}
function autoGrow(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,120)+'px'; }
function handleKey(e){ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMsg(); } }
function askQuick(q){ document.getElementById('input').value=q; sendMsg(); }
function scrollBottom(){ const c=document.getElementById('chat'); setTimeout(()=>c.scrollTop=c.scrollHeight,50); }
function addMsgToUI(role, text, save=true){
  const box=document.getElementById('messages');
  const div=document.createElement('div'); div.className='msg '+(role==='user'?'user':'ai');
  div.innerHTML=`<div class="msg-avatar">${role==='user'?'👤':'🤖'}</div><div class="msg-body"><div class="msg-name">${role==='user'?'You':'BEZOS AI'}</div><div class="msg-text">${formatText(text)}</div>${role==='ai'?`<div class="msg-actions"><button class="small-btn" onclick="copyText(this)">📋 Copy</button><button class="small-btn" onclick="likeMsg(this)">👍 Good</button><button class="small-btn" onclick="speakText(this)">🔊 Speak</button></div>`:''}</div>`;
  box.appendChild(div); scrollBottom();
  if(save && currentId){
    const c=chats.find(x=>x.id===currentId); if(c){ c.msgs.push({role,text}); if(c.msgs.length===1) c.title=text.slice(0,35); saveChats(); }
  }
}
function copyText(btn){ const txt=btn.closest('.msg-body').querySelector('.msg-text').innerText; navigator.clipboard.writeText(txt); showToast('Copied! 📋'); }
function likeMsg(btn){ btn.textContent='❤️ Loved!'; showToast('Thanks! I go do better ❤️'); }
function speakText(btn){ const txt=btn.closest('.msg-body').querySelector('.msg-text').innerText; const u=new SpeechSynthesisUtterance(txt); u.lang='en-US'; u.rate=1; speechSynthesis.speak(u); showToast('Speaking... 🔊'); }

// MAIN AI FUNCTION - Uses Free AI, Answers Everything
async function sendMsg(){
  const inp=document.getElementById('input'); const q=inp.value.trim(); if(!q || isTyping) return;
  if(!currentId) { currentId=Date.now().toString(); chats.unshift({id:currentId,title:q.slice(0,35),msgs:[],time:''}); }
  document.getElementById('welcome').style.display='none';
  addMsgToUI('user', q); inp.value=''; inp.style.height='auto'; saveChats();
  isTyping=true; document.getElementById('sendBtn').disabled=true;
  const box=document.getElementById('messages');
  const loadDiv=document.createElement('div'); loadDiv.className='msg ai'; loadDiv.id='loadingMsg';
  loadDiv.innerHTML=`<div class="msg-avatar">🤖</div><div class="msg-body"><div class="msg-name">BEZOS AI</div><div class="typing"><i></i><i></i><i></i></div><div style="font-size:12px;color:var(--muted)">Thinking... searching all knowledge...</div></div>`;
  box.appendChild(loadDiv); scrollBottom();
  try{
    // Use Pollinations Free AI - No Key Needed, Answers All Questions
    const prompt = `You are BEZOS AI, a friendly, smart AI assistant from Ghana made by BEZOS. You can answer ALL questions in the world: Maths, Science, English, Twi, Code, BECE, WASSCE, Business, History, Bible, Health, Love, Everything. Be clear, simple, step-by-step, friendly, use emojis small. If user asks in Pidgin/Twi, answer in same language. If maths, show steps. If code, give full code. User question: ${q}`;
    const res = await fetch('https://text.pollinations.ai/' + encodeURIComponent(prompt), { method:'GET', headers:{'Accept':'text/plain'} });
    let answer = await res.text();
    if(!answer || answer.length<5) throw new Error('empty');
    document.getElementById('loadingMsg')?.remove();
    // Typing effect
    let shown=''; const tempDiv=document.createElement('div'); tempDiv.className='msg ai';
    tempDiv.innerHTML=`<div class="msg-avatar">🤖</div><div class="msg-body"><div class="msg-name">BEZOS AI</div><div class="msg-text" id="typingText"></div></div>`;
    box.appendChild(tempDiv); scrollBottom();
    const target=document.getElementById('typingText');
    for(let i=0;i<answer.length;i+=3){ shown=answer.slice(0,i+3); target.innerHTML=formatText(shown); if(i%60===0) scrollBottom(); await new Promise(r=>setTimeout(r,8)); }
    target.innerHTML=formatText(answer);
    tempDiv.querySelector('.msg-body').innerHTML += `<div class="msg-actions"><button class="small-btn" onclick="copyText(this)">📋 Copy</button><button class="small-btn" onclick="likeMsg(this)">👍 Good</button><button class="small-btn" onclick="speakText(this)">🔊 Speak</button></div>`;
    if(currentId){ const c=chats.find(x=>x.id===currentId); if(c){ c.msgs.push({role:'ai',text:answer}); saveChats(); } }
  }catch(e){
    document.getElementById('loadingMsg')?.remove();
    // OFFLINE FALLBACK - Still answers many questions without internet AI
    let fallback = getOfflineAnswer(q);
    addMsgToUI('ai', fallback);
  }
  isTyping=false; document.getElementById('sendBtn').disabled=false; scrollBottom();
}
function getOfflineAnswer(q){
  const l=q.toLowerCase();
  if(l.includes('set theory')||l.includes('set')) return `**Set Theory - For BECE**\n\nA Set is a collection of things.\n\n**Example:** A = {1,2,3,4}\n\n**Types:**\n- Union (∪) = Join together: {1,2} ∪ {2,3} = {1,2,3}\n- Intersection (∩) = Common: {1,2} ∩ {2,3} = {2}\n- Empty Set = {} or ∅\n\n**Solve:** If A={1,2,3}, B={3,4}, then A ∪ B = {1,2,3,4}\n\nWant more BECE questions? Ask me!`;
